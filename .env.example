# === PskovCord: пример окружения ===
# Скопируй в .env:  cp .env.example .env   (или в PowerShell: copy .env.example .env)

# Имя приложения — единственный источник правды. Нигде не хардкодить.
APP_NAME=PskovCord

# --- PostgreSQL ---
POSTGRES_DB=pskovcord
POSTGRES_USER=pskovcord
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis (presence + Channels layer) ---
REDIS_URL=redis://redis:6379/0

# --- Django ---
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- TURN/STUN (свой coturn, dev-значения по умолчанию) ---
# Прод: TURN_SECRET сгенерировать через `openssl rand -hex 32`,
# TURN_HOST — публичный IP/домен сервера.
TURN_SECRET=dev-insecure-turn-secret
TURN_HOST=localhost
TURN_PORT=3478

# --- SFU (свой mediasoup Node-сервис) — медиа-транспорт голоса ---
# SFU_SECRET — общий секрет Django↔SFU для подписи access-токена (HS256).
#   Прод: сгенерировать `openssl rand -hex 32`, тот же секрет задать SFU-сервису.
# SFU_PUBLIC_URL — WS-адрес сигналинга SFU, который бэкенд отдаёт клиенту.
SFU_SECRET=dev-insecure-sfu-secret
SFU_PUBLIC_URL=ws://localhost:4443
# --- Настройки самого SFU-сервиса (читает Node, см. sfu/) ---
# SFU_LISTEN_PORT — порт WS-сигналинга (должен совпадать с портом в SFU_PUBLIC_URL).
# SFU_ANNOUNCED_IP — публичный/LAN IP, который SFU сообщает клиентам для ICE
#   (localhost для локали; на сервере — реальный публичный IP).
# SFU_RTC_MIN_PORT/MAX_PORT — UDP/TCP-диапазон для медиа mediasoup (открыть на фаерволе).
SFU_LISTEN_PORT=4443
SFU_ANNOUNCED_IP=127.0.0.1
SFU_RTC_MIN_PORT=40000
SFU_RTC_MAX_PORT=40100
