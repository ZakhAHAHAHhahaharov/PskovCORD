# === PskovCord: пример окружения ===
# Скопируй в .env:  cp .env.example .env   (или в PowerShell: copy .env.example .env)

# Имя приложения — единственный источник правды. Нигде не хардкодить.
APP_NAME=PskovCord

# --- PostgreSQL ---
POSTGRES_DB=pskovcord
POSTGRES_USER=pskovcord
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis (presence + Channels layer) ---
REDIS_URL=redis://redis:6379/0

# --- Django ---
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- LiveKit (dev-режим использует эти ключи по умолчанию) ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
