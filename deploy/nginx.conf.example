# Реальный файл на сервере: /etc/nginx/sites-available/pskovcord
# TLS — общий wildcard-сертификат *.zlgvpn.org, лежит на сервере в
# /etc/letsencrypt/live/zlgvpn.org/ (выпускается/продлевается централизованно,
# НЕ через certbot этого сервера — свой renewal-таймер сюда не относится).

server {
    listen 443 ssl;
    server_name pskord.zlgvpn.org;

    ssl_certificate /etc/letsencrypt/live/zlgvpn.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/zlgvpn.org/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # WebSocket-gateway — отдельный location с upgrade-заголовками
    # и увеличенным read timeout (голосовые/чат-сессии живут долго).
    location /ws/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }

    # Сигналинг SFU (mediasoup, порт 4443 на хосте — наружу НЕ открыт).
    # Через тот же домен и TLS, поэтому клиент ходит по wss:// без mixed content.
    # Сам медиапоток идёт мимо nginx — напрямую на UDP/TCP 40000-40100.
    location /sfu {
        proxy_pass http://127.0.0.1:4443;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }
}

server {
    listen 80;
    server_name pskord.zlgvpn.org;
    return 301 https://$host$request_uri;
}
