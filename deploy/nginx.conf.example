# Реальный файл на сервере: /etc/nginx/sites-available/pskovcord
# TLS — общий wildcard-сертификат *.zlgvpn.org, лежит на сервере в
# /etc/letsencrypt/live/zlgvpn.org/ (выпускается/продлевается централизованно,
# НЕ через certbot этого сервера — свой renewal-таймер сюда не относится).

server {
    listen 443 ssl;
    server_name pskord.zlgvpn.org;

    ssl_certificate /etc/letsencrypt/live/zlgvpn.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/zlgvpn.org/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Nginx по умолчанию режет тело запроса на 1 МБ — гораздо меньше, чем то,
    # что backend вообще-то готов принять: JSON-аватар/баннер-гифка (data-URL
    # base64, до DATA_UPLOAD_MAX_MEMORY_SIZE=10 МБ, см. config/settings.py) и
    # вложения сообщений (multipart, до MAX_ATTACHMENT_BYTES=25 МБ, см.
    # chat/models.py). Без этой строки такие запросы падали на самом nginx
    # с его дефолтной страницей "413 Request Entity Too Large", даже не
    # добравшись до Django — а сообщение об ошибке от бэкенда (понятное,
    # про конкретный лимит конкретного поля) пользователь так и не видел.
    client_max_body_size 30m;

    # Собранная статика (в т.ч. admin/css,js) — отдаём напрямую, минуя Django:
    # в проде (DEBUG=0) runserver сам её не раздаёт. Путь — bind-mount
    # ./staticfiles из docker-compose.prod.yml (backend collectstatic
    # складывает туда при старте контейнера, см. entrypoint.sh).
    location /static/ {
        alias /opt/pskovcord/deploy/staticfiles/;
    }

    # Вложения сообщений (chat.models.Attachment). ОТДЕЛЬНЫЙ location до
    # общего /media/ — из-за двух заголовков ниже.
    #
    # Файлы сюда кладут пользователи, а отдаются они с того же домена, что и
    # само приложение, где в localStorage лежит JWT. Без этих заголовков
    # загруженный .html или .svg открывался бы как ДОКУМЕНТ на нашем origin,
    # то есть выполнял бы свой скрипт с доступом к токенам всякого, кто по
    # нему кликнул — классический stored-XSS через загрузку файла.
    #
    #   Content-Disposition: attachment — браузер такой ответ скачивает, а не
    #     открывает. На встраивание это НЕ влияет: <img>/<video>/<audio>
    #     заголовок игнорируют, поэтому картинки в чате видны как обычно.
    #   nosniff — запрещает угадывать тип в обход Content-Type (иначе
    #     браузер сам «опознал» бы HTML в файле, отданном как octet-stream).
    #
    # Первый рубеж — на бэкенде: тип определяется по содержимому, и всё, что
    # небезопасно встраивать, помечается application/octet-stream (chat/uploads.py).
    # Здесь второй, на случай ошибки в первом.
    location /media/attachments/ {
        alias /opt/pskovcord/deploy/media/attachments/;
        add_header Content-Disposition "attachment" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Прочие пользовательские загрузки (favicon-наборы, см. core.models.Favicon) —
    # тем же приёмом, что и /static/: bind-mount ./media из
    # docker-compose.prod.yml, отдаём напрямую, минуя Django.
    location /media/ {
        alias /opt/pskovcord/deploy/media/;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # WebSocket-gateway — отдельный location с upgrade-заголовками
    # и увеличенным read timeout (голосовые/чат-сессии живут долго).
    location /ws/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }

    # Сигналинг SFU (mediasoup, порт 4443 на хосте — наружу НЕ открыт).
    # Через тот же домен и TLS, поэтому клиент ходит по wss:// без mixed content.
    # Сам медиапоток идёт мимо nginx — напрямую на UDP/TCP 40000-40100.
    location /sfu {
        proxy_pass http://127.0.0.1:4443;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }
}

server {
    listen 80;
    server_name pskord.zlgvpn.org;
    return 301 https://$host$request_uri;
}
